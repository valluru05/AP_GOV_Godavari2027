# =====================================================================
# CivicProof Platform - Production & Development Environment Configuration
# Target Deployment: Government of Andhra Pradesh — Godavari Pushkaralu 2027
# =====================================================================

PROJECT_NAME="CivicProof"
VERSION="1.0.0"

# Environment Mode: 'production' | 'pilot' | 'demo'
ENVIRONMENT="production"

# Cryptographic Secret Key for JWT Signing
# GENERATE A UNIQUE 256-BIT HIGH-ENTROPY KEY FOR PRODUCTION:
# Execute in terminal: openssl rand -hex 32
SECRET_KEY="replace-this-with-a-real-256-bit-high-entropy-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie Security (set to true when deploying over TLS / HTTPS)
COOKIE_SECURE=false

# ---------------------------------------------------------------------
# Database Connection Configuration
# ---------------------------------------------------------------------
# Option A: Production PostgreSQL (Recommended for multi-worker containerized deployments)
DATABASE_URL="postgresql+psycopg://civic_user:civic_secure_pass_godavari2027@localhost:5432/civicproof_db"
POSTGRES_DB="civicproof_db"
POSTGRES_USER="civic_user"
POSTGRES_PASSWORD="civic_secure_pass_godavari2027"

# Option B: Local / Zero-Setup Evaluation SQLite with WAL mode
# DATABASE_URL="sqlite:///./civicproof.db"

# Database Connection Pool Tuning
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ---------------------------------------------------------------------
# Security, Rate Limiting & Access Control
# ---------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:80,http://localhost:8008,http://127.0.0.1:5173,http://127.0.0.1:8008,https://civicproof.ap.gov.in"

# Rate Limiting for Authentication Endpoints
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=20
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Evidence Storage Directory (Access-controlled, never publicly exposed via web server)
STORAGE_DIR="./data/storage"

# Optional Frontend Override (if frontend is hosted on separate domain/CDN)
# VITE_API_BASE_URL="/api/v1"
